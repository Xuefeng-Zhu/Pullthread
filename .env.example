# Free endless play and earned tools work without service keys.
# Keep disabled until the matching backend + native sandbox checkout are verified.
EXPO_PUBLIC_COMMERCE_ENABLED=0
EXPO_PUBLIC_COMMERCE_ENVIRONMENT=sandbox
# Optional local development only: mock (never enables real web purchases).
EXPO_PUBLIC_COMMERCE_MODE=native
# New builds use Workers. Leave provider unset only for legacy Firebase Functions.
EXPO_PUBLIC_COMMERCE_BACKEND_PROVIDER=workers
EXPO_PUBLIC_COMMERCE_BACKEND_URL=

# RevenueCat public SDK keys only. Never put secret REST/webhook keys here.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Firebase public app configuration; enable Anonymous Auth in that project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
