# auto: use a configured native RevenueCat key, otherwise use the development
# mock in development and keep purchases unavailable in production.
# mock: deterministic local purchase UI only; production builds ignore it and
# grant no new access. A previously RevenueCat-verified offline cache remains.
# revenuecat: require the matching native platform public SDK key.
EXPO_PUBLIC_ENTITLEMENT_MODE=auto

# RevenueCat platform public SDK keys. Keep environment-specific values in the
# local .env or build environment. Never put a RevenueCat secret API key here.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
