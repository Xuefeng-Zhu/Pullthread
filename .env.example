# auto: use a configured native RevenueCat key, otherwise use the development
# mock in development and keep purchases unavailable in production.
# mock: deterministic local purchase UI only; production builds ignore it and
# grant no new access. A previously RevenueCat-verified offline cache remains.
# revenuecat: require the matching native platform public SDK key.
EXPO_PUBLIC_ENTITLEMENT_MODE=auto

# RevenueCat platform public SDK keys. Keep environment-specific values in the
# local .env or build environment. Never put a RevenueCat secret API key here.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# local: deterministic Daily Scrap plus the one-player device leaderboard.
# firebase: keep the local save first, then lazily enable anonymous Auth,
# Firestore standings, and the replay-validating callable function.
EXPO_PUBLIC_DAILY_SERVICE=local

# Firebase web-app configuration is public client metadata, not an Admin SDK
# credential. Leave these empty in local mode. Never put a service-account key,
# private key, or other privileged Firebase credential in EXPO_PUBLIC_*.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
