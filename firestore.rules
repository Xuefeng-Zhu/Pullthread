rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validDisplayName(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 24
        && value.matches('^[A-Za-z0-9][A-Za-z0-9 _-]{0,23}$');
    }

    function validProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'createdAt',
          'updatedAt'
        ])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validProfileUpdate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'updatedAt'
        ])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    match /profiles/{userId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow create: if validProfileCreate(userId);
      allow update: if validProfileUpdate(userId);
      allow delete: if false;
    }

    // Challenge descriptors are deterministic and are materialized only by
    // trusted server code. Clients may fetch a day directly or list a bounded
    // window, but can never author or alter the catalog.
    match /daily_challenges/{challengeId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 31;
      allow write: if false;

      // The callable function validates and re-simulates every replay, then
      // uses the Admin SDK to keep one best document per user and challenge.
      // Admin SDK writes bypass these rules; direct client writes stay denied.
      match /runs/{userId} {
        allow get: if true;
        allow list: if request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
