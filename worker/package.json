{
  "name": "pullthread-commerce-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:test": "esbuild test/*.test.ts --bundle --packages=external --platform=node --target=node24 --format=esm --outdir=lib-test",
    "test": "npm run typecheck && npm run build:test && node --test --test-concurrency=1 lib-test/*.test.js",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260907.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.1"
  }
}
